# Preferred when you cannot create a Help Scout OAuth app.
HELPSCOUT_API_KEY=

# Leave blank to auto-detect. Supported: static_token, oauth_client_credentials, oauth_refresh_token.
HELPSCOUT_AUTH_MODE=
HELPSCOUT_APP_ID=
HELPSCOUT_APP_SECRET=
HELPSCOUT_CLIENT_ID=
HELPSCOUT_CLIENT_SECRET=
HELPSCOUT_REFRESH_TOKEN=
HELPSCOUT_API_BASE_URL=https://api.helpscout.net/v2
HELPSCOUT_MCP_ENABLE_WRITES=false
HELPSCOUT_MCP_HTTP_HOST=127.0.0.1
HELPSCOUT_MCP_HTTP_PORT=3344
HELPSCOUT_MCP_HTTP_TOKEN=
HELPSCOUT_MCP_OAUTH_ENABLED=false
HELPSCOUT_MCP_PUBLIC_URL=
HELPSCOUT_MCP_OAUTH_SECRET=
HELPSCOUT_MCP_OAUTH_PASSWORD=
HELPSCOUT_MCP_OAUTH_ENABLE_CIMD=false
HELPSCOUT_MCP_ALLOW_STATIC_TOKEN_WITH_OAUTH=false
HELPSCOUT_MCP_LOG_LEVEL=info

# Live tests are opt-in.
HELPSCOUT_RUN_LIVE_TESTS=false
HELPSCOUT_RUN_LIVE_WRITE_TESTS=false
HELPSCOUT_LIVE_MAILBOX_ID=
HELPSCOUT_LIVE_CUSTOMER_EMAIL=
